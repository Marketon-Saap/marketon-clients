{
  "name": "karbot-landing-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker · Karbot landing backend · Google Calendar API integration para agendar demos con Isabel sin UI de Google",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "secret:client_id": "wrangler secret put GOOGLE_CLIENT_ID",
    "secret:client_secret": "wrangler secret put GOOGLE_CLIENT_SECRET",
    "secret:refresh_token": "wrangler secret put GOOGLE_REFRESH_TOKEN"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
